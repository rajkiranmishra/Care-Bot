# CARE-BOT Environment Configuration Template
# Copy this file to .env and configure for local development
# NEVER commit the actual .env file containing sensitive credentials to Git

# Application Settings
PROJECT_NAME="CARE-BOT"
PROJECT_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# Server Host & Port
HOST="127.0.0.1"
PORT=8000

# Database Configuration (SQLite)
# For local development, an absolute or relative sqlite path
DATABASE_URL="sqlite:///./carebot.db"

# Cryptographic Security & Device Authentication
# In production, SECRET_KEY must be a cryptographically random string (min 32 chars, e.g. openssl rand -hex 32)
SECRET_KEY="carebot-development-secret-key-32-chars-long-do-not-use-in-prod!"
# Hardware device key for smart-speaker integration (e.g. NFC tap, physical emergency button)
# Must be configured explicitly; no insecure default is used in production.
DEVICE_API_KEY="carebot-hardware-device-key-local-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial administrator bootstrap token (one-time secret for provisioning the first Caregiver)
# Passed in X-Bootstrap-Token header. Permanently disabled once the first administrator exists.
BOOTSTRAP_TOKEN="carebot-test-bootstrap-secret-token-32chars!"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000"

# Local AI & LLM Engine Settings (Ollama / Local Inference)
# Set LOCAL_LLM_PROVIDER="ollama" to connect to local Ollama service, or "mock" for offline deterministic testing
LOCAL_LLM_PROVIDER="mock"
OLLAMA_BASE_URL="http://localhost:11434"
# Selectable models: "qwen2.5:7b" (primary development model) or "qwen2.5:3b" (lightweight alternative)
LOCAL_LLM_MODEL="qwen2.5:7b"
LLM_TIMEOUT_SECONDS=12.0
LLM_TEMPERATURE=0.2
