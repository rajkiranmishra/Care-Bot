# CARE-BOT Environment Configuration Template
# Copy this file to .env and configure for local development
# NEVER commit the actual .env file containing sensitive credentials to Git

# Application Settings
PROJECT_NAME="CARE-BOT"
PROJECT_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# Server Host & Port
HOST="127.0.0.1"
PORT=8000

# Database Configuration (SQLite)
# For local development, an absolute or relative sqlite path
DATABASE_URL="sqlite:///./carebot.db"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000"

# Future Local AI Settings (Phase 4 placeholder)
OLLAMA_BASE_URL="http://localhost:11434"
LOCAL_LLM_MODEL="qwen2.5:3b"
